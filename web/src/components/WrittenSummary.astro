---
import { ArrowUpRight, ChevronDown, Sparkles } from "lucide-react";
import { scoreColor } from "../lib/games.js";

// A short written summary from the exported facts, labelled as AI-written, with the longer version folded away
const { summary, pct } = Astro.props;
const join = (sentences) => sentences.map((sentence) => sentence.text).join(" ");
---

{summary && (
  <section class="tldr" data-reveal aria-label="Summary" style={`--tldr-color: ${scoreColor(pct)}`}>
    <div class="tldr-head">
      <span class="tldr-label">TL;DR</span>
      <span class="tldr-note"><Sparkles />AI-generated summary from review data · <a href="/faq/#written-summary">Learn more here<ArrowUpRight /></a></span>
    </div>
    <p class="tldr-text">{join(summary.tldr)}</p>
    {summary.details?.length > 0 && (
      <details class="tldr-more">
        <summary>Read more<ChevronDown /></summary>
        <p>{join(summary.details)}</p>
      </details>
    )}
  </section>
)}
