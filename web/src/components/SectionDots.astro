---
// Side dots outline, items are (anchor, label)
const { items, labeled = false, after = null } = Astro.props;
---

<nav class:list={["section-dots", { labeled }]} data-gated={after ?? undefined} aria-label="On this page">
  {items.map(([anchor, label], i) => (
    <a href={`#${anchor}`} data-dot={anchor} aria-current={i === 0 ? "true" : undefined}>
      <span class="dot-label">{label}</span>
      <span class="dot" aria-hidden="true"></span>
    </a>
  ))}
</nav>

<script>
  // Active section: last one past a line sliding from 40% to the bottom
  const nav = document.querySelector(".section-dots");
  const gate = nav?.dataset.gated ? document.getElementById(nav.dataset.gated) : null;
  const dots = [...document.querySelectorAll("[data-dot]")];
  const sections = dots.map((dot) => document.getElementById(dot.dataset.dot));
  const update = () => {
    const room = document.documentElement.scrollHeight - innerHeight;
    const progress = room > 0 ? Math.min(1, Math.max(0, scrollY / room)) : 0;
    const line = innerHeight * (0.4 + 0.6 * progress);
    let active = 0;
    sections.forEach((section, i) => { if (section && section.getBoundingClientRect().top <= line) active = i; });
    dots.forEach((dot, i) => (i === active ? dot.setAttribute("aria-current", "true") : dot.removeAttribute("aria-current")));
    // Hidden until the gate section scrolls away
    if (gate) nav.classList.toggle("past", gate.getBoundingClientRect().bottom < innerHeight * 0.55);
  };
  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  addEventListener("load", update);
  update();
</script>
