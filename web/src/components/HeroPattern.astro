---
import { Bug, Gamepad2, MessageSquare, Music, Palette, Star, Swords, ThumbsDown, ThumbsUp, TrendingUp } from "lucide-react";

// Static backdrop for the home page hero: one tile of small brand icons scattered on a jittered grid, repeated across the hero.
// A fixed seed keeps the scatter the same on every build
const TILE = 520;
const CELLS = 5;
const SEED = 7;
const EMPTY_SHARE = 0.2;

// Small seeded random number generator (mulberry32), so the scatter never changes between builds
function random(seed) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Icons as (kind, tone): "mark" is the logo controller, "bars" the logo's praise and complaint lines, the rest Lucide icons
const ICONS = [
  ["mark", "brand"], [ThumbsUp, "blue"], ["bars", "brand"], [MessageSquare, "muted"], [Star, "blue"], [ThumbsDown, "red"],
  [Gamepad2, "muted"], [TrendingUp, "blue"], ["mark", "brand"], [Bug, "red"], [Swords, "muted"], ["bars", "brand"],
  [Palette, "muted"], [ThumbsUp, "blue"], [Music, "muted"], [MessageSquare, "muted"],
];

// Up to one icon per grid cell (some cells left empty), nudged well off-centre, turned a little and sized at random
const next = random(SEED);
const cell = TILE / CELLS;
const icons = Array.from({ length: CELLS * CELLS }, (_, i) => {
  const [kind, tone] = ICONS[Math.floor(next() * ICONS.length)];
  const size = 18 + next() * 20;
  const x = (i % CELLS) * cell + cell / 2 + (next() - 0.5) * cell * 0.7;
  const y = Math.floor(i / CELLS) * cell + cell / 2 + (next() - 0.5) * cell * 0.7;
  const angle = (next() - 0.5) * 60;
  const empty = next() < EMPTY_SHARE;
  return { kind, Icon: typeof kind === "string" ? null : kind, tone, size, x, y, angle, empty };
}).filter((icon) => !icon.empty);
---

<svg class="hero-pattern" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="hero-pattern" width={TILE} height={TILE} patternUnits="userSpaceOnUse">
      {icons.map(({ kind, Icon, tone, size, x, y, angle }) => (
        <g class={`pat-${tone}`} transform={`translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${angle.toFixed(1)})`}>
          {kind === "mark" ? (
            <g transform={`scale(${(size / 64).toFixed(3)}) translate(-32 -32)`}>
              <path class="pat-outline" d="M18 9.8H46C53.5 9.8 57.5 14.6 59.5 23L62.5 41C63.6 48.8 60 54.2 54.5 54.2C50.5 54.2 48.2 51.3 46 47L44 42.8H20L18 47C15.8 51.3 13.5 54.2 9.5 54.2C4 54.2 .4 48.8 1.5 41L4.5 23C6.5 14.6 10.5 9.8 18 9.8Z" />
              <rect class="pat-praise" x="16" y="14" width="32" height="6.5" rx="3.25" />
              <rect class="pat-praise" x="16" y="23.5" width="24" height="6.5" rx="3.25" />
              <rect class="pat-complaint" x="16" y="33" width="14" height="6.5" rx="3.25" />
            </g>
          ) : kind === "bars" ? (
            <g transform={`scale(${(size / 40).toFixed(3)}) translate(-20 -12)`}>
              <rect class="pat-praise" x="0" y="0" width="40" height="6" rx="3" />
              <rect class="pat-praise" x="0" y="9" width="30" height="6" rx="3" />
              <rect class="pat-complaint" x="0" y="18" width="17" height="6" rx="3" />
            </g>
          ) : (
            <Icon x={-size / 2} y={-size / 2} size={size} strokeWidth={1.75} />
          )}
        </g>
      ))}
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#hero-pattern)" />
</svg>
