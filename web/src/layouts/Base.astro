---
import { CircleHelp, Gamepad2, House, Menu, Monitor, Moon, Sun } from "lucide-react";
import "../styles/global.css";

const { title } = Astro.props;

// Sidebar pages as (address, label, icon); game pages count as Games
const pages = [["/", "Home", House], ["/games/", "Games", Gamepad2], ["/faq/", "FAQ", CircleHelp]];
const here = Astro.url.pathname.replace(/\/?$/, "/");
const current = (href) => here === href || (href === "/games/" && here.startsWith("/game/"));

// Theme choices as (key, label, icon)
const themes = [["light", "Light", Sun], ["dark", "Dark", Moon], ["system", "System", Monitor]];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `SteamTLDR - ${title}` : "SteamTLDR"}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quantico:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem("steamtldr_theme") || "system"; }
      catch { document.documentElement.dataset.theme = "system"; }
    </script>
  </head>
  <body>
    <header class="topbar">
      <a href="/"><img src="/logo.svg" alt="SteamTLDR" /></a>
      <button class="menu-button" aria-label="Menu"><Menu size={26} /></button>
    </header>
    <aside class="sidebar">
      <a class="logo" href="/"><img src="/logo.svg" alt="SteamTLDR" /></a>
      <nav class="pages">
        {pages.map(([href, label, Icon]) => (
          <a href={href} aria-current={current(href) ? "page" : undefined}><Icon />{label}</a>
        ))}
      </nav>
      <slot name="sidebar" />
      <div class="sidebar-footer">
        <div class="theme-switch" role="group" aria-label="Theme">
          {themes.map(([key, label, Icon]) => (
            <button data-theme-choice={key} title={`${label} theme`} aria-label={`${label} theme`}><Icon size={20} /></button>
          ))}
        </div>
      </div>
    </aside>
    <main>
      <slot />
      <footer class="site-footer">
        <span>© 2026 Jonathan Tam</span>
        <span>Not affiliated with Valve or Steam. Game names, images and reviews belong to their respective owners.</span>
      </footer>
    </main>
  </body>
</html>

<script>
  // Switch light/dark/system and remember it in this browser
  for (const button of document.querySelectorAll("[data-theme-choice]")) {
    button.addEventListener("click", () => {
      document.documentElement.dataset.theme = button.dataset.themeChoice;
      try { localStorage.setItem("steamtldr_theme", button.dataset.themeChoice); } catch {}
    });
  }

  // Open and close the sidebar on phones
  document.querySelector(".menu-button").addEventListener("click", () => document.body.classList.toggle("menu-open"));
</script>
