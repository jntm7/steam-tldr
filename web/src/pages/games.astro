---
import Page from "../layouts/Page.astro";
import Library from "../components/Library.jsx";
import RecentGames from "../components/RecentGames.jsx";
import { games } from "../lib/data.js";
import { withImages } from "../lib/images.js";
import { gameName } from "../lib/games.js";

// Game names by app ID for the recently viewed list
const names = Object.fromEntries(games.map((game) => [game.appid, gameName(game)]));

// Games with small copies of their art
const withArt = await Promise.all(games.map(withImages));
---

<Page title="Games" kicker="Library"
  lede={`Search, filter by genre or score, and open one to see what players love and complain about.`}>
  <Fragment slot="heading">Browse every <em class="accent-word">game</em></Fragment>
  <RecentGames slot="header" names={names} client:load />
  <Library games={withArt} client:load />
</Page>
