---
import { ChevronDown, CircleHelp, Flame, Gamepad2, Sparkles, TrendingUp } from "lucide-react";
import Landing from "../layouts/Landing.astro";
import HomeSection from "../components/HomeSection.astro";
import HeroPattern from "../components/HeroPattern.astro";
import HeroReport from "../components/HeroReport.jsx";
import GithubIcon from "../assets/github.svg";
import HuggingFaceIcon from "../assets/huggingface.svg";
import { games, settings, summaries } from "../lib/data.js";
import { withWideBanner } from "../lib/images.js";
import { heroCards } from "../lib/landing.js";
import { formatCount, tableRows } from "../lib/games.js";

// Trending needs this many reviews in the last 30 days, and this many earlier months to know the usual;
// games with fewer months are new releases, listed apart from trending
const TRENDING_MIN_REVIEWS = 500;
const TRENDING_MIN_MONTHS = 3;
const ROW_GAMES = 5;

// Headline numbers across every game
const steamReviews = games.reduce((sum, game) => sum + (game.summary?.total_reviews ?? 0), 0);
const sampledReviews = games.reduce((sum, game) => sum + game.sampled_reviews, 0);

// Middle value of a list of numbers, or 0 for an empty list
function median(values) {
  if (values.length === 0) return 0;
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2;
}

// A game's reviews in the last 30 days, whether it's too new to have a usual month, and the recent reviews
// as a multiple of its usual month, the median of the months before (as for flagged events)
function reviewActivity(summary) {
  const months = tableRows(summary.trend);
  const recent = months.at(-1).reviews;
  const isNew = months.length - 1 < TRENDING_MIN_MONTHS;
  const usual = median(months.slice(-1 - settings.flag_lookback_months, -1).map((month) => month.reviews));
  const surge = !isNew && recent >= TRENDING_MIN_REVIEWS && usual > 0 ? recent / usual : 0;
  return { recent, isNew, surge };
}

const byAppid = Object.fromEntries(games.map((game) => [game.appid, game]));
const activity = summaries
  .filter((summary) => byAppid[summary.appid])
  .map((summary) => ({ game: byAppid[summary.appid], ...reviewActivity(summary) }));

// New releases with the most reviews lately, then the games getting the most reviews compared with their usual month
const newReleases = activity
  .filter((game) => game.isNew && game.recent >= TRENDING_MIN_REVIEWS)
  .sort((a, b) => b.recent - a.recent)
  .slice(0, ROW_GAMES);
const surgingGames = activity
  .filter((game) => game.surge > 1)
  .sort((a, b) => b.surge - a.surge)
  .slice(0, ROW_GAMES);
const popularGames = [...games].sort((a, b) => (b.summary?.total_reviews ?? 0) - (a.summary?.total_reviews ?? 0)).slice(0, ROW_GAMES);

// Each section with its games, and one headline figure per game
const compact = new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 });
const sections = [
  { id: "new", title: "New", Icon: Sparkles, caption: "Releases with the most reviews in the last 30 days",
    items: newReleases.map(({ game, recent }) => ({ game, badge: "New", figure: compact.format(recent), unit: "Reviews Past 30D" })) },
  { id: "trending", title: "Trending", Icon: TrendingUp, caption: "Games getting more reviews than in their usual month",
    items: surgingGames.map(({ game, surge }) => ({ game, figure: `${surge.toFixed(1)}×`, unit: "usual reviews" })) },
  { id: "popular", title: "Popular", Icon: Flame, caption: "The most reviewed games on Steam in our library",
    items: popularGames.map((game) => ({ game, figure: compact.format(game.summary.total_reviews), unit: "reviews" })) },
];

// Hero stats
const stats = [
  ["Games analyzed", games.length, "dots"],
  ["Reviews analyzed", sampledReviews, "bars"],
  ["English reviews on Steam", steamReviews, "share"],
];

// Stat graphics
const sampleSizes = games.map((game) => game.sampled_reviews).sort((a, b) => b - a);
const bars = Array.from({ length: 24 }, (_, i) => sampleSizes[Math.floor((i * sampleSizes.length) / 24)] / sampleSizes[0]);
const shareOfSteam = sampledReviews / steamReviews;

// Hero report cards for a few games, each with its banner
const cards = await Promise.all(heroCards(games, summaries).map(async (card) => ({ ...card, banner: (await withWideBanner(byAppid[card.appid])).wide })));

---

<Landing>
  <section class="hero">
    <div class="hero-backdrop" aria-hidden="true"><HeroPattern /></div>
    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-title">Steam gives a score. <span>SteamTLDR gives the <em class="accent-word">why</em>.</span></h1>
        <p class="hero-lede">
          The praise, the complaints and where opinion is heading, pulled from thousands of player reviews so you don't have to read them.
        </p>
        <div class="buttons">
          <a class="button primary" href="/games/"><Gamepad2 />Browse games</a>
          <div class="button-group">
            <a class="button secondary" href="/faq/"><CircleHelp />FAQ</a>
            <a class="button secondary icon" href="https://github.com/jntm7/steam-tldr" target="_blank" rel="noreferrer" aria-label="Source on GitHub" title="Source on GitHub"><GithubIcon aria-hidden="true" /></a>
            <a class="button secondary icon" href="https://huggingface.co/jntam/steamtldr" target="_blank" rel="noreferrer" aria-label="Model on Hugging Face" title="Model on Hugging Face"><HuggingFaceIcon aria-hidden="true" /></a>
          </div>
        </div>
        <dl class="hero-stats">
          {stats.map(([label, value, kind]) => (
            <div>
              <dt>{label}</dt>
              {kind === "dots" && <div class="stat-graphic dots" aria-hidden="true">{Array.from({ length: games.length }, (_, i) => <i style={`--i: ${i}`}></i>)}</div>}
              {kind === "bars" && <div class="stat-graphic bars" aria-hidden="true">{bars.map((height, i) => <i style={`--h: ${height.toFixed(3)}; --i: ${i}`}></i>)}</div>}
              {kind === "share" && (
                <div class="stat-graphic share" aria-hidden="true">
                  <div class="share-track"><i style={`--share: ${(shareOfSteam * 100).toFixed(2)}%`}></i></div>
                  <span>{(shareOfSteam * 100).toFixed(1)}% of them read</span>
                </div>
              )}
              <dd><span class="sr-only">{formatCount(value)}</span><span aria-hidden="true" data-count={value}>{formatCount(value)}</span></dd>
            </div>
          ))}
        </dl>
      </div>
      {cards.length > 0 && <HeroReport cards={cards} client:visible />}
    </div>
    <a class="scroll-hint" href="#rows"><span>Scroll to Explore</span><ChevronDown aria-hidden="true" /></a>
  </section>

  <div class="page-width page-content" id="rows">
    {sections.map((section) => <HomeSection {...section} />)}
  </div>
</Landing>
