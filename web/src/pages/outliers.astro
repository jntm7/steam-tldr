---
import { ChartLine, Gamepad2, LayoutDashboard, Lightbulb, List, TrendingDown, TriangleAlert, Zap } from "lucide-react";
import Page from "../layouts/Page.astro";
import EventList from "../components/EventList.jsx";
import EventTimeline from "../components/EventTimeline.jsx";
import Equation from "../components/Equation.astro";
import { games, settings } from "../lib/data.js";
import { flaggedEvents } from "../lib/events.js";
import { COMPLAINT_COLOR, PRAISE_COLOR, formatCount } from "../lib/games.js";

const s = settings;
const events = await flaggedEvents();

// Headline numbers: how many events, how many games, and the most dramatic ones
const surges = events.filter((event) => event.kind === "Negative surge").length;
const worst = events.reduce((best, event) => (event.dropPoints > best.dropPoints ? event : best), events[0]);
const biggest = events.reduce((best, event) => (event.extraNegatives > best.extraNegatives ? event : best), events[0]);
const gamesAffected = new Set(events.map((event) => event.appid)).size;

// Page outline as (anchor, heading), matching the headings below
const dots = [
  ["overview", "Overview"],
  ["event-list", "Events"],
  ["when-they-happened", "Timeline"],
  ["how-its-detected", "Detection"],
];
---

<Page title="Outliers" kicker="Outliers" dots={dots}
  lede="Months when a game got a surge of negative reviews or its score dropped sharply, across every game analyzed.">
  <Fragment slot="heading">Review bombs and <em class="accent-word bad">score drops</em></Fragment>

  {events.length === 0 ? (
    <p>No flagged events in any game.</p>
  ) : (
    <>
      <section class="panel" id="overview" data-reveal>
        <h2><LayoutDashboard color={COMPLAINT_COLOR} />Overview</h2>
        <p class="caption">How many events there are, and which were the most dramatic</p>
        <div class="stats">
          <div>
            <div class="cell-label"><TriangleAlert />Flagged events</div>
            <div class="cell-stat"><span class="sr-only">{events.length}</span><span aria-hidden="true" data-count={events.length}>{events.length}</span></div>
            <div class="cell-sub">{surges} negative surges and {events.length - surges} score drops</div>
          </div>
          <div>
            <div class="cell-label"><Gamepad2 />Games affected</div>
            <div class="cell-stat">{gamesAffected} of {games.length}</div>
          </div>
          <div>
            <div class="cell-label"><TrendingDown />Biggest drop</div>
            <div class="cell-stat word">{worst.game}</div>
            <div class="cell-sub">▼ {worst.dropPoints.toFixed(0)} pts, {worst.when}: {worst.pct.toFixed(0)}% positive vs a usual {worst.usualPct.toFixed(0)}%</div>
          </div>
          <div>
            <div class="cell-label"><Zap />Most extra negatives</div>
            <div class="cell-stat"><span class="sr-only">{formatCount(biggest.extraNegatives)}</span><span aria-hidden="true" data-count={biggest.extraNegatives}>{formatCount(biggest.extraNegatives)}</span></div>
            <div class="cell-sub">{biggest.game}, {biggest.when}</div>
          </div>
        </div>
      </section>

      <section class="panel" id="event-list" data-reveal>
        <h2><List color={COMPLAINT_COLOR} />Events</h2>
        <p class="caption">Select a game to open its page. Runs of consecutive flagged months count as one event.</p>
        <EventList events={events} client:load />
      </section>

      <section class="panel" id="when-they-happened" data-reveal>
        <h2><ChartLine color={COMPLAINT_COLOR} />Timeline</h2>
        <p class="caption">Every flagged event across all games, by when it started and how far the score fell</p>
        <EventTimeline events={events} client:visible />
      </section>
    </>
  )}

  <section class="panel" id="how-its-detected" data-reveal>
    <h2><Lightbulb color={PRAISE_COLOR} />Detection</h2>
    <p class="caption">Each month is compared with the game's usual: the median of its previous {s.flag_lookback_months} months</p>
    <Equation
      label="Negative surge"
      terms={[
        [`${s.surge_negative_ratio}×`, "usual negative reviews, at least"],
        [`${s.surge_extra_negatives}+`, "more negative reviews than usual"],
        [`${s.surge_score_drop} pts`, "below the usual score, at least"],
      ]}
    />
    <Equation
      label="Score drop"
      terms={[
        [`${formatCount(s.drop_min_reviews)}+`, "reviews that month"],
        [`${s.drop_score_points} pts`, "below the usual score, at least"],
      ]}
    />
    <p>
      Launch months are never flagged, since a game needs 3 earlier months to compare with. Consecutive flagged months count as one event,
      and counts are Steam's exact monthly totals, not samples.
    </p>
  </section>
</Page>
